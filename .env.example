# Hugging Face model used by POST /tag.
SYNAPIC_MODEL_ID=Salesforce/blip-image-captioning-base
# Set to cpu for predictable deployments without CUDA.
SYNAPIC_DEVICE=cpu
SYNAPIC_HOST=0.0.0.0
SYNAPIC_PORT=8080
SYNAPIC_LOG_LEVEL=info
SYNAPIC_MAX_IMAGE_BYTES=10485760
# Maximum number of waiting /tag requests held by the in-process queue.
SYNAPIC_QUEUE_CAPACITY=16
# Number of synchronous model calls run concurrently in worker threads.
SYNAPIC_WORKER_COUNT=1
